# Aceita EXPO_PUBLIC_* (cole o .env do Expo) ou as chaves curtas.
# Runtime carrega .env.<flavor> → .env → .env.<flavor>.example → este arquivo.
# Linha GCP (release/0.2): default flavor/mode = gcp. DO vivo fica no flavor digitalocean / branch prod.

FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=crowdfans-prod.firebaseapp.com
FIREBASE_PROJECT_ID=crowdfans-prod
FIREBASE_STORAGE_BUCKET=crowdfans-prod.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# Backend: gcp | gcp_prod | digitalocean | local
APP_FLAVOR=gcp
API_MODE=gcp

API_LOCAL_BASE_URL=http://localhost:8080

# Cloud Run (preencher URL real pós-deploy; CF-286+). Placeholders alinhados ao serviço.
API_GCP_BASE_URL=https://crowdfans-server-staging.southamerica-east1.run.app
API_GCP_STAGING_BASE_URL=https://crowdfans-server-staging.southamerica-east1.run.app
API_GCP_PROD_BASE_URL=https://crowdfans-server-prod.southamerica-east1.run.app

# DigitalOcean (flavor digitalocean / hotfixes na branch prod — não é default aqui)
API_DIGITALOCEAN_BASE_URL=https://crowdfans-server-prod-h9qb6.ondigitalocean.app
# GCP staging (release/0.2) — placeholder até Cloud Run existir (CF-286).
# API_MODE=gcp
# API_GCP_STAGING_BASE_URL=https://REPLACE_ME-crowdfans-server-staging-XXXX.southamerica-east1.run.app
# Override forçado (qualquer modo):
# API_BASE_URL=

# EXPO_PUBLIC_SENTRY_DSN=
# SENTRY_DSN=
# ENV=production

# Tenor (CF-197 seletor de GIF). Sem chave → erro recuperável na UI, não mock.
# EXPO_PUBLIC_TENOR_API_KEY=
# TENOR_API_KEY=
