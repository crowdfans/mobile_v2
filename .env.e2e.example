# Credenciais de contas de teste para Patrol E2E (Flutter).
# Copie para `.env.e2e` (gitignored) e preencha com usuários reais de teste.
# Nunca commite valores reais.
#
# Injete no Patrol com --dart-define (ou .patrol.env — ver README):
#   patrol test -t integration_test/e2e_....dart \
#     --dart-define=E2E_FAN_EMAIL=... \
#     --dart-define=E2E_FAN_PASSWORD=...

E2E_FAN_EMAIL=
E2E_FAN_PASSWORD=
E2E_ARTIST_EMAIL=
E2E_ARTIST_PASSWORD=

# Opcionais — seeds para fluxos autenticados
E2E_ARTIST_UID=
E2E_FAN_UID=
E2E_FAN_HANDLE=
E2E_SEED_POST_ID=
